{
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "db:generate": "pnpm --filter backend exec drizzle-kit generate",
    "db:migrate": "pnpm --filter backend exec drizzle-kit migrate",
    "db:push": "pnpm --filter backend exec drizzle-kit push",
    "db:seed": "pnpm --filter backend exec tsx src/db/seed.ts",
    "db:studio": "pnpm --filter backend exec drizzle-kit studio",
    "lint": "pnpm --filter '*' lint",
    "typecheck": "pnpm --filter '*' typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
